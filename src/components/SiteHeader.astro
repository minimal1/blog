---
import { withBase } from "../lib/site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const navigation = [
  { href: withBase("/projects"), label: "프로젝트" },
  { href: withBase("/logs"), label: "모든 기록" },
  { href: withBase("/tags"), label: "태그" },
  { href: withBase("/about"), label: "소개" },
];
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="brand" href={withBase("/")} aria-label="홈으로 이동">
      <span class="brand__mark" aria-hidden="true"></span>
      <span>MINIMAL.LOG</span>
    </a>
    <nav aria-label="주요 탐색">
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--background) 92%, transparent);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .brand__mark {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0.25rem var(--accent-soft);
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 3vw, 1.7rem);
  }

  nav a {
    color: var(--text-soft);
    font-size: 0.82rem;
    font-weight: 630;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text);
  }

  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45rem;
  }

  @media (max-width: 640px) {
    .site-header__inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.85rem;
      padding-block: 1rem;
    }

    nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
