<button
  class="theme-toggle"
  type="button"
  aria-label="다크 모드로 전환"
  aria-pressed="false"
  data-theme-toggle
>
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.4 15.1A8.5 8.5 0 0 1 8.9 3.6 8.5 8.5 0 1 0 20.4 15.1Z"></path>
  </svg>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  function syncToggle(theme: "light" | "dark") {
    if (!toggle) return;

    const isDark = theme === "dark";
    toggle.setAttribute("aria-pressed", String(isDark));
    toggle.setAttribute("aria-label", isDark ? "라이트 모드로 전환" : "다크 모드로 전환");
  }

  const initialTheme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  syncToggle(initialTheme);

  toggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = nextTheme;
    document.documentElement.style.colorScheme = nextTheme;
    localStorage.setItem("theme", nextTheme);
    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      "content",
      nextTheme === "dark" ? "#09090b" : "#ffffff",
    );
    syncToggle(nextTheme);
  });
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.15rem;
    height: 2.15rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text-soft);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--line-strong);
    color: var(--accent-strong);
  }

  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .theme-toggle__moon {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-toggle__sun {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-toggle__moon {
    display: block;
  }
</style>
