---
import { projectStatuses } from "../lib/site";

interface Props {
  status: keyof typeof projectStatuses;
}

const { status } = Astro.props;
const statusMeta = projectStatuses[status];
const statusSymbols = {
  active: "●",
  testing: "◆",
  steady: "✓",
} as const;
---

<span class:list={["status", `status--${statusMeta.tone}`]}>
  <span class="status__symbol" aria-hidden="true">{statusSymbols[statusMeta.tone]}</span>
  {statusMeta.label}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.36rem;
    width: fit-content;
    padding: 0.27rem 0.55rem;
    border: 1px solid;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 720;
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .status__symbol {
    display: inline-grid;
    place-items: center;
    width: 0.72rem;
    font-size: 0.62rem;
    line-height: 1;
  }

  .status--active {
    border-color: var(--status-active-line);
    background: var(--status-active-surface);
    color: var(--status-active-text);
  }

  .status--testing {
    border-color: var(--status-testing-line);
    background: var(--status-testing-surface);
    color: var(--status-testing-text);
  }

  .status--steady {
    border-color: var(--status-steady-line);
    background: var(--status-steady-surface);
    color: var(--status-steady-text);
  }
</style>
