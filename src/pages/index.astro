---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LogList from "../components/LogList.astro";
import {
  publishedLogs,
  sortProjects,
  withBase,
} from "../lib/site";

const projects = sortProjects(await getCollection("projects"));
const logs = publishedLogs(await getCollection("logs"));
const logCounts = new Map(
  projects.map((project) => [
    project.id,
    logs.filter((log) => log.data.project.id === project.id).length,
  ]),
);
---

<Layout>
  <section class="hero">
    <p class="eyebrow">Build in public</p>
    <h1>혼자 만드는 과정도<br />제품의 일부니까.</h1>
    <p>
      작은 제품을 만들며 내린 선택, 틀린 가정, 출시 이후의 숫자를 정리합니다.
      완성된 결과보다 그 사이의 과정을 기록합니다.
    </p>
    <div class="hero__stats" aria-label="블로그 현황">
      <span><strong>{projects.length}</strong> 프로젝트</span>
      <span><strong>{logs.length}</strong> 공개 기록</span>
      <span><strong>1</strong> 개발자</span>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <div class="section-heading">
      <h2 id="projects-heading">지금 만들고 있는 것</h2>
      <a href={withBase("/projects")}>모든 프로젝트 보기</a>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard project={project} logCount={logCounts.get(project.id)} />
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="logs-heading">
    <div class="section-heading">
      <h2 id="logs-heading">최근 개발 기록</h2>
      <a href={withBase("/logs")}>모든 기록 보기</a>
    </div>
    <LogList logs={logs.slice(0, 6)} projects={projects} />
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    align-content: end;
    min-height: 34rem;
    padding-block: 6rem 4rem;
  }

  h1 {
    max-width: 55rem;
    margin: 0;
    font-size: clamp(3rem, 8vw, 6.8rem);
    font-weight: 790;
    letter-spacing: -0.075em;
    line-height: 0.98;
    word-break: keep-all;
  }

  .hero > p:not(.eyebrow) {
    max-width: 38rem;
    margin: 1.8rem 0 2.6rem;
    color: var(--text-soft);
    font-size: 1.05rem;
    line-height: 1.8;
    word-break: keep-all;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    color: var(--text-soft);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.74rem;
  }

  .hero__stats strong {
    color: var(--text);
    font-size: 1rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  @media (max-width: 880px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 27rem;
      padding-block: 4rem 2.5rem;
    }
  }
</style>
