---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import { withBase } from "../lib/site";
import { canonicalURL } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  width?: "wide" | "reading";
}

const {
  title,
  description = "혼자 만들고, 선택하고, 실패한 과정을 숨기지 않고 기록합니다.",
  width = "wide",
} = Astro.props;
const pageTitle = title ? `${title} · 미니멀의 빌드 로그` : "미니멀의 빌드 로그";
const canonical = canonicalURL(Astro.url, Astro.site);
const socialImage = new URL(withBase("/social-preview.png"), Astro.site);
const socialImageAlt = "MINIMAL.LOG — 미니멀의 빌드 로그";
const pageType = [
  "/projects/[project]/logs/[...slug]",
  "/season1/[id]",
].includes(Astro.routePattern) ? "article" : "website";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="미니멀의 빌드 로그" />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme = savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : prefersDark ? "dark" : "light";

          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute(
            "content",
            theme === "dark" ? "#09090b" : "#ffffff",
          );
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main class={width === "reading" ? "reading-shell" : "page-shell"}>
      <slot />
    </main>
    <footer class="site-footer page-shell">
      <p>작게 만들고, 자주 공개합니다.</p>
      <p>© {new Date().getFullYear()} Minimal</p>
    </footer>
  </body>
</html>

<style>
  main {
    min-height: calc(100vh - 15rem);
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 7rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--text-soft);
    font-size: 0.78rem;
  }

  .site-footer p {
    margin: 0;
  }

  @media (max-width: 520px) {
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
