---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import { withBase } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  width?: "wide" | "reading";
}

const {
  title,
  description = "혼자 만들고, 선택하고, 실패한 과정을 숨기지 않고 기록합니다.",
  width = "wide",
} = Astro.props;
const pageTitle = title ? `${title} · 미니멀의 빌드 로그` : "미니멀의 빌드 로그";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main class={width === "reading" ? "reading-shell" : "page-shell"}>
      <slot />
    </main>
    <footer class="site-footer page-shell">
      <p>작게 만들고, 자주 공개합니다.</p>
      <p>© {new Date().getFullYear()} Minimal</p>
    </footer>
  </body>
</html>

<style>
  main {
    min-height: calc(100vh - 15rem);
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 7rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--text-soft);
    font-size: 0.78rem;
  }

  .site-footer p {
    margin: 0;
  }

  @media (max-width: 520px) {
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
